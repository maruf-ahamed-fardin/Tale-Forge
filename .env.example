# TaleForge development environment

ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live AI Integration (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Database
DATABASE_URL=postgresql+psycopg://taleforge:taleforge_dev_password@localhost:5432/taleforge
POSTGRES_DB=taleforge
POSTGRES_USER=taleforge
POSTGRES_PASSWORD=taleforge_dev_password

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=10080

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_UPLOAD_MB=50

# AI configuration
MODEL_NAME=
MODEL_ADAPTER_PATH=

# Your own trained LoRA model ("TaleForge LoRA" in chat).
# Set the SAME random value for both the web app and the API server; leave empty to disable.
LOCAL_MODEL_TOKEN=
# Where the web app's server reaches the FastAPI backend
INTERNAL_API_URL=http://127.0.0.1:8000
GENERATION_CONFIG_PATH=./configs/generation.yaml
TRAINING_CONFIG_PATH=./configs/training.yaml
