# TaleForge development environment

ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live AI Integration (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Database
DATABASE_URL=postgresql+psycopg://taleforge:taleforge_dev_password@localhost:5432/taleforge
POSTGRES_DB=taleforge
POSTGRES_USER=taleforge
POSTGRES_PASSWORD=taleforge_dev_password

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=10080

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_UPLOAD_MB=50

# AI configuration
MODEL_NAME=
MODEL_ADAPTER_PATH=

# Google Cloud (optional). With GCS_BUCKET set, training stories, chat history and the Story Library are
# stored in this Cloud Storage bucket instead of local files, so they survive restarts and serverless hosts (Vercel).
GCS_BUCKET=
# Service-account key JSON on one line (roles: Storage Object Admin on the bucket, plus Vertex AI User
# for cloud training). Leave empty to use Application Default Credentials (gcloud auth application-default login).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cloud training: fine-tune Gemini on your stories with Vertex AI ("TaleForge LoRA" in chat).
# Needs GCS_BUCKET (same region as VERTEX_LOCATION). When set, this replaces the local LoRA model below.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_TUNING_BASE_MODEL=gemini-2.5-flash
# Secret you type on the Training page to start a (paid) training job
TUNING_ACCESS_KEY=

# Your own trained LoRA model ("TaleForge LoRA" in chat).
# Set the SAME random value on the web app and on the model server; leave empty to disable.
LOCAL_MODEL_TOKEN=
# Production: the deployed model endpoint (see ai/deploy/README.md), e.g.
# https://<workspace>--taleforge-lora-storymodel-web.modal.run . Leave empty to use INTERNAL_API_URL.
LORA_MODEL_URL=
# Where the web app's server reaches the FastAPI backend
INTERNAL_API_URL=http://127.0.0.1:8000
GENERATION_CONFIG_PATH=./configs/generation.yaml
TRAINING_CONFIG_PATH=./configs/training.yaml
